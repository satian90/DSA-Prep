public class Solution {
    public int MaxArea(int[] height) {
        var left = 0;
        var right = height.Length-1;
        var max= 0;
        while(left<right)
        {
            var width = right-left;
            var hgt = 0;

            
            if(height[right]>height[left])
            {
                hgt = height[left];
                left ++;
            }
            else
            {
                hgt = height[right];
                right --;
            }
            var area = hgt * width;
            max = max>area?max:area;
        }
        return max;
    }
}
