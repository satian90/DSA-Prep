public class Solution {
    public int FirstStableIndex(int[] nums, int k) {
        for(int i=0 ; i< nums.Length; i++)
        {
            var max = nums[i];
            var min = nums[i];
            for(int y=0;y<i;y++)
            {
                max=Math.Max(max,nums[y]);
            }
            for(int y=i;y<nums.Length;y++)
            {
                min=Math.Min(min,nums[y]);
            }
            
            var instability = max-min;
            if(instability<=k)
            {
                return i;
            }
        }
        return -1;
    }
}
