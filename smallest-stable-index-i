public class Solution {
    public int FirstStableIndex(int[] nums, int k) {

            var n = nums.Length;
            var max = nums[0];

            int[] MinArr= new int [n];
            MinArr[n-1] = nums[n-1];

            for(int y=n-2;y>=0;y--)
            {
                MinArr[y]=Math.Min(nums[y],MinArr[y+1]);
            }
            for(int y=0;y<nums.Length;y++)
            {
                max=Math.Max(max,nums[y]);
                var instability = max - MinArr[y];
                 if(instability<=k)
                {
                    return y;
                }
            }
            
                   return -1;
        }
    }
